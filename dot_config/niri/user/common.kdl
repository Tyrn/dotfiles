//
// Common settings presumably good enough
// for any desktop or laptop using IBus.
//
// IN CASE THE CONFIG FILES (niri/config.kdl, niri/dms/*.kdl)
// ARE DEFAULT/GENERATED:
//
// Append these includes at the end of config.kdl:

// //include "user/custom.kdl"  // For a laptop, mostly.
// include "user/common.kdl"
//
// Comment out (with /-):
//
// input from config.kdl
// Mod+Space ... {} from dms/binds.kdl
//
input {
    keyboard {
        xkb {
        }
        //numlock
    }
    touchpad {
        tap
    }
    mouse {
    }
    trackpoint {
    }
}

spawn-at-startup "ibus" "start" "--type" "wayland"
/-spawn-at-startup "bash" "-c" "piri daemon > /dev/null 2>&1 &"

binds {
    // Mod+Space reserved for IBus switch.
    /-Mod+Space hotkey-overlay-title=null {
        spawn "true";
    }
    Ctrl+Space hotkey-overlay-title="Application Launcher" {
        spawn "dms" "ipc" "call" "spotlight" "toggle";
    }
}

layout {
    tab-indicator {
        // Position it to your liking: "top", "bottom", "left", or "right"
        position "top"

        // "place-within-column" prevents it from overlaying other columns
        place-within-column

        // Visual styling
        hide-when-single-tab
        width 4
        gap 8
        length total-proportion=1.0

        // Optional: Customize colors (can also be gradients)
        //active-color "#80c8ff"
        active-color "#ff6600"  // Safety Orange
        //active-color "#ff00ff"
        inactive-color "#ffffff55"
    }
}

window-rule {
    match app-id="firefox"
    open-maximized true
}

window-rule {
    match app-id="google-chrome"
    open-maximized true
}

window-rule {
    match app-id="org.kde.dolphin"
    open-maximized true
}

window-rule {
    match app-id="thunar"
    open-maximized true
}

window-rule {
    match app-id="org.qbittorrent.qBittorrent"
    open-maximized true
}

window-rule {
    match app-id="org.telegram.desktop"
    open-maximized true
}
