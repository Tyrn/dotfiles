#!/usr/bin/env bash
# Syntax marker; do not run

# Shared base options so aliases stay DRY
if command -v eza &>/dev/null; then
  _eza_base=(eza --group-directories-first --icons=never)

  alias ls='${_eza_base[*]}'
  alias l='${_eza_base[*]} -lbF --git'
  alias ll='${_eza_base[*]} -laF --git'
  alias la='${_eza_base[*]} -lbhHigUmuSa --time-style=long-iso --git --color-scale'
  alias lt='${_eza_base[*]} --tree --level=2'
  alias lta='${_eza_base[*]} -a --tree --level=2'

  function lls() {
    "${_eza_base[@]}" -laF --git --color=always "$@" | less -R
  }

  function lss() {
    "${_eza_base[@]}" --color=always "$@" | less -R
  }
else
  alias ls='ls --color=auto --group-directories-first'
  alias l='ls -lFh'
  alias ll='ls -lAFh'
  alias la='ls -laFh'

  function lls() {
    command ls -lAh --color=always "$@" | less -R
  }

  function lss() {
    command ls --color=always "$@" | less -R
  }
fi

# Git-aware tree: supports `gt`, `gt DIR`, `gt LEVEL`, or `gt DIR LEVEL`
function gt() {
  local dir="."
  local level=""

  for arg in "$@"; do
    if [[ "$arg" =~ ^[0-9]+$ ]]; then
      level="$arg"
    else
      dir="$arg"
    fi
  done

  if [[ -n "$level" ]]; then
    eza --long --tree --git-ignore --icons=auto --level="$level" "$dir"
  else
    eza --tree --git-ignore --icons=auto "$dir"
  fi
}

chezmoi_toml="$HOME/.config/chezmoi/chezmoi.toml"

function get_chezmoi_value() {
  local table="${1}"
  local key="${2}"

  [[ -f "$chezmoi_toml" ]] || {
    printf '%s\n' "🔸"
    return 0
  }

  python3 -c '
import sys, tomllib
try:
    with open(sys.argv[1], "rb") as f:
        val = tomllib.load(f).get(sys.argv[2], {}).get(sys.argv[3])
    print(sys.argv[4] if val is None else val)
except Exception:
    print(sys.argv[4])
' "$chezmoi_toml" "$table" "$key" "🔸"
}

# Resolves a chezmoi key to its MTP mount path.
# Requires manual configuration (chezmoi.toml).
function _lz_base() {
  local key="$1"
  local table=data
  local value
  value=$(get_chezmoi_value "$table" "$key")

  if [[ "$value" == 🔸* ]]; then
    printf '%s should have an entry like this:\n[%s]\n...\n%s = "%s"\n %s\n' \
      "$chezmoi_toml" "$table" "$key" "/deep storage/preciouss" "⛵" >&2
    return 1
  fi

  : "${mtp_mountpoint:?mtp_mountpoint must be set (the MTP mount root)}"
  printf '%s%s\n' "$mtp_mountpoint" "$value"
}

# Checks your favorite MTP phone directory.
#
# Usage, simple and advanced:
#
#   _lz phoneKey
#   noglob _lz phoneKey *Martin*
#
# To get an idea about _lz expectations,
# run something unexpected:
#
#   _lz boo
#
# Styled to please shellcheck and shfmt
function _lz() {
  local base
  base=$(_lz_base "$1") || return 1
  shift

  if (($#)); then
    setopt local_options glob_subst nonomatch
    local -a targets=()
    local p
    for p in "$@"; do
      # shellcheck disable=SC2206
      targets+=("$base"/$p)
    done
    lf "${targets[@]}"
  else
    li "$base"
  fi
}

# Prints the nearest existing ancestor of TARGET (or "." if none).
# Symlinks are followed: a valid link resolves to its target; a dangling
# link is treated as existing here (df will report its containing fs).
function _df_target() {
  local target="${1:-.}"
  while [[ ! -e "$target" && ! -L "$target" && "$target" != "/" ]]; do
    target="${target:h}"
  done
  [[ -e "$target" || -L "$target" ]] || target="."
  printf '%s\n' "$target"
}

function lf() { # flat entries, no descending
  eza -lbF --git --group-directories-first -d "${@:-.}"
  df -h "$(_df_target "${1:-.}")"
}

function li() { # contents, one level of introspection
  eza -lbF --git --group-directories-first --level=1 "${@:-.}"
  df -h "$(_df_target "${1:-.}")"
}

# Shortcuts for daily routine ('noglob' lets you omit quotes around *)
alias lz='noglob _lz'
alias laud='noglob _lz phoneAudiobooks'

mtp_mountpoint="$HOME/.qin"

# Android File Transfer, mount
function aftm() {
  mkdir -p "$mtp_mountpoint"
  aft-mtp-mount "$mtp_mountpoint"
}

# Android File Transfer, unmount
function aftu() {
  fusermount -u "$mtp_mountpoint"
}

# ────────────────────────────────────────────────────────────────
# So far the use of mtp-mount is experimental.
# Notes:
# - Filesystem: to Size, Used, etc. all the mounted devices
#   (Internal, SD card) are lumped together. df output is useless.
# ────────────────────────────────────────────────────────────────

# mtp-rs, mount
function mtpm() {
  mkdir -p "$mtp_mountpoint"
  mtp-mount "$mtp_mountpoint" &
}

# mtp-rs, unmount
function mtpu() {
  umount "$mtp_mountpoint"
}

# Helps to revive MTP strangled by Plasma KDE apps.
function kiok() {
  killall -w kiod6
}

# Shows where aliases are defined (including shadowed ones),
# using a zsh startup trace.
#
# Styled to please bashls, shellcheck, and shfmt
function findalias() {
  emulate -L zsh
  setopt localoptions no_aliases

  local name="${1:-}"
  case "$name" in
  -h | --help)
    cat <<'EOF'
Usage: findalias [NAME]

Find where your shell aliases are defined, including ones that get overwritten.

  (no args)   Show every  loaded alias, along with its source file.
  NAME        Find the exact file and line number where a specific alias is set.
  -h, --help  Display this help message.

Examples:
  findalias        # List all the available aliases
  findalias ll     # See where 'll' is defined (and if anything overrides it)
EOF
    return 0
    ;;
  esac

  local line loc def aname val found=0
  local sq="'"
  while IFS= read -r line; do
    loc="${line%%>*}"
    loc="${loc#+}"
    def="${line#*> alias "${sq}"}" # strip "+file:line> alias '"
    def="${def%"${sq}"}"           # strip trailing "'"
    aname="${def%%=*}"
    val="${def#*=}"

    if [[ -z "$name" ]]; then
      printf '%-20s %s\n' "$aname" "$loc"
      found=1
    elif [[ "$aname" == "$name" ]]; then
      printf '%s\n  alias %s=\x27%s\x27\n' "$loc" "$aname" "$val"
      found=1
    fi
  done < <(zsh -ixc : </dev/null 2>&1 | grep -E "^\+[^>]*> alias '")

  if ((! found)); then
    printf 'findalias: no alias %sfound\n' "${name:+$name }" >&2
    return 1
  fi
}
