mtp_mountpoint="$HOME/.qin"

# Android File Transfer, mount
function aftm() {
  mkdir -p "$mtp_mountpoint"
  aft-mtp-mount "$mtp_mountpoint"
}

# Android File Transfer, unmount
function aftu() {
  fusermount -u "$mtp_mountpoint"
}

# Helps to revive MTP strangled by Plasma KDE apps.
function kiok() {
  killall -w kiod6
}

# ────────────────────────────────────────────────────────────────
# The use of mtp-mount isn't quite experimental any more. mtp-info
# is recommended as a single tool for mounting MTP gadgets.
#
# Notes on aft, or Android File Transfer:
# - Copying files circa 1GiB with general purpose tools
#   is unreliable.
#
# Notes on mtp-mount:
# - For Filesystem Size, Used, etc., all the mounted devices
#   (Internal, SD card) are lumped together. df output is useless.
# ────────────────────────────────────────────────────────────────

# mtp-rs, mount
function mtpm() {
  mkdir -p "$mtp_mountpoint"
  (
    set +m
    mtp-mount "$mtp_mountpoint" >/dev/null 2>&1 &
    echo $!
  ) >/dev/null

  local i
  for ((i = 0; i < 30; i++)); do
    mountpoint -q "$mtp_mountpoint" && return 0
    ((i == 3)) && print -u2 'Wait...'
    sleep 0.1
  done

  print -u2 "mtpm: mount failed; check the cable"
  return 1
}

# mtp-rs, unmount
function mtpu() {
  # Try to find and terminate the mtp-mount process gracefully
  if pgrep -f "mtp-mount $mtp_mountpoint" >/dev/null; then
    pkill -TERM -f "mtp-mount $mtp_mountpoint"
    # Give it a moment to clean up the MTP session
    sleep 1
  fi
  # Now unmount (should be a no-op if pkill worked)
  mountpoint -q "$mtp_mountpoint" && umount "$mtp_mountpoint" 2>/dev/null || true
}

# Shows every storage device of the
# plugged in MTP gadget.
#
# Makes it mounted via mtp-mount
# and fully accessible.
#
# Safe to be called repeatedly.
function mtp-info() {
  mtpu
  aft-info
  mtpm
}

# Lists available MTP storages without mounting them.
function aft-info() {
  emulate -L zsh 2>/dev/null || true

  local line id desc info used free total pct
  local -a storages
  local attempt

  # Enumerate storages, retrying briefly: the phone's MTP interface can
  # take a moment to become claimable right after plugging in.
  for ((attempt = 0; attempt < 5; attempt++)); do
    storages=()
    while IFS= read -r line; do
      case "$line" in
      [0-9]*[[:space:]]*)
        id=${line%%[[:space:]]*}
        desc=${line#"$id"}
        desc=${desc#"${desc%%[![:space:]]*}"}
        case "$desc" in
        *"description:"*) desc=${desc##*description:} ;;
        esac
        desc=${desc#"${desc%%[![:space:]]*}"}
        storages+=("$id"$'\t'"$desc")
        ;;
      esac
    done < <(aft-mtp-cli storage-list 2>/dev/null)
    ((${#storages[@]} > 0)) && break
    sleep 1
  done

  if ((${#storages[@]} == 0)); then
    print -u2 'aft-info: no storages found (device busy, locked, or not in MTP mode?)' 2>/dev/null ||
      printf '%s\n' 'aft-info: no storages found (device busy, locked, or not in MTP mode?)' >&2
    return 1
  fi

  _aft_human() {
    awk -v b="$1" 'BEGIN {
      if      (b >= 1073741824) printf "%.1f GiB", b/1073741824;
      else if (b >= 1048576)    printf "%.1f MiB", b/1048576;
      else if (b >= 1024)       printf "%.1f KiB", b/1024;
      else                      printf "%d B", b;
    }'
  }

  local entry
  for entry in "${storages[@]}"; do
    id=${entry%%$'\t'*}
    desc=${entry#*$'\t'}

    info=$(aft-mtp-cli "storage-info $id" 2>/dev/null | grep -E '^used ' || true)
    if [[ -z "$info" ]]; then
      printf '%s [%s]: (no info)\n' "$desc" "$id"
      continue
    fi

    used=$(awk '{print $2}' <<<"$info")
    free=$(awk '{print $5}' <<<"$info")
    total=$(awk '{print $8}' <<<"$info")
    pct=$(awk -v u="$used" -v t="$total" 'BEGIN { printf "%d", (t>0 ? 100*u/t : 0) }')

    printf '%s [%s]: size %s, used %s (%s%%), free %s\n' \
      "$desc" "$id" "$(_aft_human "$total")" "$(_aft_human "$used")" "$pct" "$(_aft_human "$free")"
  done
}

# Shows where aliases are defined (including shadowed ones),
# using a zsh startup trace.
#
# Styled to please bashls, shellcheck, and shfmt
function findalias() {
  emulate -L zsh
  setopt localoptions no_aliases

  local name="${1:-}"
  case "$name" in
  -h | --help)
    cat <<'EOF'
Usage: findalias [NAME]

Find where your shell aliases are defined, including ones that get overwritten.

  (no args)   Show every  loaded alias, along with its source file.
  NAME        Find the exact file and line number where a specific alias is set.
  -h, --help  Display this help message.

Examples:
  findalias        # List all the available aliases
  findalias ll     # See where 'll' is defined (and if anything overrides it)
EOF
    return 0
    ;;
  esac

  local line loc def aname val found=0
  local sq="'"
  while IFS= read -r line; do
    loc="${line%%>*}"
    loc="${loc#+}"
    def="${line#*> alias "${sq}"}" # strip "+file:line> alias '"
    def="${def%"${sq}"}"           # strip trailing "'"
    aname="${def%%=*}"
    val="${def#*=}"

    if [[ -z "$name" ]]; then
      printf '%-20s %s\n' "$aname" "$loc"
      found=1
    elif [[ "$aname" == "$name" ]]; then
      printf '%s\n  alias %s=\x27%s\x27\n' "$loc" "$aname" "$val"
      found=1
    fi
  done < <(zsh -ixc : </dev/null 2>&1 | grep -E "^\+[^>]*> alias '")

  if ((! found)); then
    printf 'findalias: no alias %sfound\n' "${name:+$name }" >&2
    return 1
  fi
}
