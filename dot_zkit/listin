# Shared base options so aliases stay DRY
if command -v eza &>/dev/null; then
  _eza_base=(eza --group-directories-first --icons=never)

  alias ls='${_eza_base[*]}'
  alias l='${_eza_base[*]} -lbF --git'
  alias ll='${_eza_base[*]} -laF --git'
  alias la='${_eza_base[*]} -lbhHigUmuSa --time-style=long-iso --git --color-scale'
  alias lt='${_eza_base[*]} --tree --level=2'
  alias lta='${_eza_base[*]} -a --tree --level=2'

  function lls() {
    "${_eza_base[@]}" -laF --git --color=always "$@" | less -R
  }

  function lss() {
    "${_eza_base[@]}" --color=always "$@" | less -R
  }
else
  alias ls='ls --color=auto --group-directories-first'
  alias l='ls -lFh'
  alias ll='ls -lAFh'
  alias la='ls -laFh'

  function lls() {
    command ls -lAh --color=always "$@" | less -R
  }

  function lss() {
    command ls --color=always "$@" | less -R
  }
fi

# Git-aware tree: supports `gt`, `gt DIR`, `gt LEVEL`, or `gt DIR LEVEL`
function gt() {
  local dir="."
  local level=""

  for arg in "$@"; do
    if [[ "$arg" =~ ^[0-9]+$ ]]; then
      level="$arg"
    else
      dir="$arg"
    fi
  done

  if [[ -n "$level" ]]; then
    eza --long --tree --git-ignore --icons=auto --level="$level" "$dir"
  else
    eza --tree --git-ignore --icons=auto "$dir"
  fi
}

chezmoi_toml="$HOME/.config/chezmoi/chezmoi.toml"

function get_chezmoi_value() {
  local table="${1}"
  local key="${2}"

  [[ -f "$chezmoi_toml" ]] || {
    printf '%s\n' "🔸"
    return 0
  }

  python3 -c '
import sys, tomllib
try:
    with open(sys.argv[1], "rb") as f:
        val = tomllib.load(f).get(sys.argv[2], {}).get(sys.argv[3])
    print(sys.argv[4] if val is None else val)
except Exception:
    print(sys.argv[4])
' "$chezmoi_toml" "$table" "$key" "🔸"
}

# Resolves a chezmoi key to its MTP mount path.
# Requires manual configuration (chezmoi.toml).
function _lz_base() {
  local key="$1"
  local table=data
  local value
  value=$(get_chezmoi_value "$table" "$key")

  if [[ "$value" == 🔸* ]]; then
    printf '%s should have an entry like this:\n[%s]\n...\n%s = "%s"\n %s\n' \
      "$chezmoi_toml" "$table" "$key" "/deep storage/preciouss" "⛵" >&2
    return 1
  fi

  : "${mtp_mountpoint:?mtp_mountpoint must be set (the MTP mount root)}"
  printf '%s%s\n' "$mtp_mountpoint" "$value"
}

# Checks your favorite MTP phone directory.
#
# Usage, simple and advanced:
#
#   _lz phoneKey
#   noglob _lz phoneKey *Martin*
#
# To get an idea about _lz expectations,
# run something unexpected:
#
#   _lz boo
#
# Styled to please shellcheck and shfmt
function _lz() {
  local base
  base=$(_lz_base "$1") || return 1
  shift

  if (($#)); then
    local -a targets=()
    _glob_targets targets "$base" "$@"
    eza -lbF --git --group-directories-first -d "${targets[@]}"
    df -h "$(_df_target "${targets[1]:-.}")"
  else
    eza -lbF --git --group-directories-first --level=1 "$base"
    df -h "$(_df_target "$base")"
  fi
}

# Prints the nearest existing ancestor of TARGET (or "." if none).
# Symlinks are followed: a valid link resolves to its target; a dangling
# link is treated as existing here (df will report its containing fs).
function _df_target() {
  local target="${1:-.}"
  while [[ ! -e "$target" && ! -L "$target" && "$target" != "/" ]]; do
    target="${target:h}"
  done
  [[ -e "$target" || -L "$target" ]] || target="."
  printf '%s\n' "$target"
}

# _glob_targets OUT_ARRAY BASE PATTERN...
#
# Fills the caller's array named OUT_ARRAY with case-insensitively globbed
# paths. Unmatched patterns are left literal (nonomatch), so eza/df still
# report them explicitly.
#
# OUT_ARRAY must already be declared (e.g. `local -a name=()`) by the caller.
# `set -A` assigns the nearest scope that defines the name; it must NOT
# collide with any local here: out_name, base, p, acc.
function _glob_targets() {
  local out_name=$1
  local base=$2
  shift 2

  setopt local_options glob_subst nonomatch
  unsetopt case_glob # ← case-insensitive globs, function-scoped

  local p
  local -a acc
  for p in "$@"; do
    # shellcheck disable=SC2206
    acc+=("$base"/$p)
  done
  set -A "$out_name" "${acc[@]}"
}

# ────────────────────────────────────────────────────────────────
# _lf/_li:
#   Close relatives of ls, with storage device info.
#   Treat glob patterns as case-insensitive.
#   Require first parameter (directory) before any glob pattern.
#   Don't require quoted glob patterns.
# ────────────────────────────────────────────────────────────────

function _lf() {
  (($#)) || {
    print -u2 'usage: lf BASE [PATTERN...]'
    return 1
  }
  local base="${1}"
  shift
  local -a targets=()
  if (($#)); then _glob_targets targets "$base" "$@"; else targets=("$base"); fi
  eza -lbF --git --group-directories-first -d "${targets[@]}"
  df -h "$(_df_target "${targets[1]:-.}")"
}

function _li() {
  (($#)) || {
    print -u2 'usage: li BASE [PATTERN...]'
    return 1
  }
  local base="${1}"
  shift
  local -a targets=()
  if (($#)); then _glob_targets targets "$base" "$@"; else targets=("$base"); fi
  eza -lbF --git --group-directories-first --level=1 "${targets[@]}"
  df -h "$(_df_target "${targets[1]:-.}")"
}

