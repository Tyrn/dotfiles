#!/usr/bin/env bash
# Syntax marker; do not run

if command -v eza &>/dev/null; then
  alias ls='eza --group-directories-first'
  alias l='eza -lbF --git --group-directories-first'
  alias ll='eza -lbGF --git --group-directories-first'
  alias la='eza -lbhHigUmuSa --time-style=long-iso --git --color-scale --group-directories-first'
  alias lt='eza --tree --level=2 --icons=always'
  alias lta='eza -a --tree --level=2 --icons=always'
fi

alias lls="ls -lha --color=always | less -r"
alias lss="ls --color=always | less -r"

function gt() {
  local dir="${1:-.}"

  if [[ -n "$2" && "$2" =~ ^[0-9]+$ ]]; then
    eza --long --tree --git-ignore --level="$2" "$dir"
  else
    eza --tree --git-ignore "$dir"
  fi
}

chezmoi_toml="$HOME/.config/chezmoi/chezmoi.toml"

function get_chezmoi_value() {
  local table="${1}"
  local key="${2}"

  [[ -f "$chezmoi_toml" ]] || {
    printf '%s\n' "🔸"
    return 0
  }

  python3 -c "
import sys, tomllib
try:
    with open(sys.argv[1], 'rb') as f:
        val = tomllib.load(f).get('$table', {}).get('$key')
    print(sys.argv[2] if val is None else val)
except Exception:
    print(sys.argv[2])
" "$chezmoi_toml" "🔸"
}

# resolve_globs OUT_ARRAY BASE PATTERN...
#
# Fills the caller's array named OUT_ARRAY with resolved paths.
# Unmatched patterns warn to stderr and pass through literally.
#
# NOTE: OUT_ARRAY must already be declared (e.g. `local -a name=()`) by the
#   caller. `set -A` assigns the nearest scope that defines the name; it must
#   NOT collide with any local here: out_name, base, p, hit, acc.
#   (`paths_like_no_other` in the caller is a deliberately unique name.)
function resolve_globs() {
  local out_name=$1
  local base=$2
  shift 2

  local p
  local -a hit acc

  # Enable Zsh globbing for variable expansions and nullglob locally
  setopt local_options glob_subst null_glob

  for p in "$@"; do
    # With glob_subst + null_glob active, unquoted $p expands as a glob
    # and resolves to nothing if unmatched, while $base stays safely quoted
    # shellcheck disable=SC2206
    hit=("$base"/$p)

    if ((${#hit[@]})); then
      acc+=("${hit[@]}")
    else
      # funcstack[2] is the caller in Zsh; fallback avoids shellcheck array/unset warnings
      printf '%s: no match: %q\n' "${funcstack[2]:-resolve_globs}" "$base/$p" >&2
      acc+=("$base/$p")
    fi
  done

  # zsh: assign the array named by $out_name (indirect array assignment)
  set -A "$out_name" "${acc[@]}"
}

# Checks your favorite MTP phone directory.
# Requires manual configuration (chezmoi.toml).
#
# Usage, simple and advanced:
#
#   lz phoneKey
#   lz phoneKey '*Martin*'
#
# To get an idea about lz expectations,
# run something unexpected:
#
#   lz boo
#
# Styled to please shellcheck and shfmt
function lz() {
  local key="${1}"
  shift 1
  local table=data
  local value
  value=$(get_chezmoi_value "$table" "$key")
  if [[ "$value" == 🔸* ]]; then
    printf '%s should have an entry like this:\n[%s]\n...\n%s = "%s"\n %s\n' \
      "$chezmoi_toml" "$table" "$key" "/deep storage/preciouss" "⛵"
  fi

  local base="$mtp_mountpoint$value"
  if (($#)); then
    local -a paths_like_no_other=()
    resolve_globs paths_like_no_other "$base" "$@"
    lf "${paths_like_no_other[@]}"
  else
    li "$base"
  fi
}

function lf() { # flat entries, no descending
  eza -lbF --git --group-directories-first -d "${@:-.}"
  df -h "${1:-.}"
}

function li() { # contents, one level of introspection
  eza -lbF --git --group-directories-first --level=1 "${@:-.}"
  df -h "${1:-.}"
}

# Shortcuts for daily routine.
alias lau='lz phoneAudiobooks'

mtp_mountpoint="$HOME/.qin"

# Android File Transfer, mount
function aftm() {
  mkdir -p "$mtp_mountpoint"
  aft-mtp-mount "$mtp_mountpoint"
}

# Android File Transfer, unmount
function aftu() {
  fusermount -u "$mtp_mountpoint"
}

# ────────────────────────────────────────────────────────────────
# So far the use of mtp-mount is experimental.
# Notes:
# - Filesystem: to Size, Used, etc. all the mounted devices
#   (Internal, SD card) are lumped together. df output is useless.
# ────────────────────────────────────────────────────────────────

# mtp-rs, mount
function mtpm() {
  mkdir -p "$mtp_mountpoint"
  mtp-mount "$mtp_mountpoint" &
}

# mtp-rs, unmount
function mtpu() {
  umount "$mtp_mountpoint"
}

# Helps to revive MTP strangled by Plasma KDE apps.
function kiok() {
  killall -w kiod6
}

# Shows where aliases are defined, using a zsh startup trace.
#
# The function starts a fresh interactive zsh with tracing enabled
# (`zsh -ixc :`), captures the trace, and extracts the alias
# definitions along with the file and line number that produced them.
function findalias() {
  emulate -L zsh
  setopt localoptions no_aliases

  local name="${1:-}"

  case "$name" in
  -h | --help)
    cat <<'EOF'
Usage: findalias [NAME]

  (no args)    list all aliases defined during zsh startup, with their source
  NAME         show the source file and line for a specific alias
  -h, --help   show this message

Examples:
  findalias
  findalias grv
  findalias gst
EOF
    return 0
    ;;
  esac

  local line location definition aname found=0
  local matches=()

  while IFS= read -r line; do
    matches+=("$line")
  done < <(zsh -ixc : </dev/null 2>&1 | grep -E "^\+[^>]*> alias '")

  if ((${#matches[@]} == 0)); then
    printf 'findalias: no alias definitions found\n' >&2
    return 1
  fi

  if [[ -z "$name" ]]; then
    for line in "${matches[@]}"; do
      location="${line%%>*}"
      location="${location#+}"
      definition="${line#*> }" # strip the space too

      aname="${definition#alias [\']}"
      aname="${aname%%=*}"

      printf '%-20s %s\n' "$aname" "$location"
    done | sort
    return 0
  fi

  for line in "${matches[@]}"; do
    location="${line%%>*}"
    location="${location#+}"
    definition="${line#*> }" # strip the space too

    if [[ "$definition" == "alias '${name}="* ]]; then
      printf '%s\n' "$location"
      printf '  %s\n' "$definition"
      found=1
    fi
  done

  if ((! found)); then
    printf 'findalias: no alias %s found\n' "$name" >&2
    return 1
  fi
}
